# Optional: use a published image with docker compose pull && docker compose up -d --no-build
STUDIO_IMAGE=ghcr.io/coronaaustralis/scrcpy-studio:latest
STUDIO_USER=admin
# Leave empty to open the Web UI without login.
STUDIO_PASSWORD=
HTTPS=false
# Include the actual server IP/domain used by the browser (no protocol or port).
TLS_HOSTS=localhost,127.0.0.1,::1
